# Cabeceras HTTP de Cloudflare Pages. Es una plantilla: al compilar, `vite.config.ts` escribe
# dist/_headers poniendo en la línea Content-Security-Policy la misma CSP de la etiqueta <meta>
# más frame-ancestors (que una <meta> ignora). No cambies esa línea a mano.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: camera=(self), microphone=(self), geolocation=(), payment=(), usb=()
  X-Robots-Tag: noindex
  Content-Security-Policy: __CSP__
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/sw.js
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
